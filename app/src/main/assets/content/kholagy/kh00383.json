["p","29-واتى السيد من أورشليم"],["e","The Master had come to Jerusalem,"],["p","حتى بلغ إلى قسقام"],["e","When it was the right time,"],["p","فوق السحابة الحقيقية مقيم"],["e","On the true cloud standing,"],["p","في إيطاف ماسف خين فيسليئيم"],["e","Fe-etav-masf khen Vath-le-eem."],["p","30-لا تنسي يا أم القدوس"],["e","Do not forget O mother of the Holy,"],["p","اشفعي فينا يا مريم"],["e","Intercede for us O Mary,"],["p","أمام سيدنا بي اخرستوس"],["e","In front of our Master Jesus,"],["p","في إيطاف ماسف خين فيسليئيم"],["e","Fe-etav-masf khen Vath-le-eem."],["p","31-يا من اتيت من علو سماك"],["e","O You who came from Your highest heaven,"],["p","واشرقت من البتول مريم"],["e","And shone from the Virgin Mary,"],["p","تطلع علينا بعين رضاك"],["e","Behold us with Your kind eye,"],["p","في إيطاف ماسف خين فيسليئيم"],["e","Fe-etav-masf khen Vath-le-eem."],["p","32-والبيعة تكون في طمأنينتك"],["e","And the church O Mary,"],["p","محفوظة دايما يا مريم"],["e","Be in peace in all times,"],["p","وتكون منصانة بشفاعتك"],["e","And to be fortified by your intercessions,"],["p","محروسة طول الأيام"],["e","And be safe through all the days."]]}